# Use "sites" only behind the trusted Sites runtime.
# Use "oidc" for the public API after choosing an identity provider.
AUTH_MODE=oidc
OIDC_ISSUER=https://identity.example.com
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_AUDIENCE=teethsee-api
ALLOWED_ORIGINS=https://relaxcrazy528-prog.github.io,https://csgeekr.com
